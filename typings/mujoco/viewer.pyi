"""Fallback typing surface for MuJoCo's passive native viewer."""

from contextlib import AbstractContextManager

from mujoco import MjData, MjModel, MjvScene

class Handle(AbstractContextManager["Handle"]):
    @property
    def user_scn(self) -> MjvScene: ...
    def lock(self) -> AbstractContextManager: ...
    def is_running(self) -> bool: ...
    def sync(self) -> None: ...
    def set_texts(self, texts: tuple[int | None, int | None, str, str]) -> None: ...

def launch_passive(model: MjModel, data: MjData) -> Handle: ...
