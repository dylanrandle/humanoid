<?xml version="1.0"?>
<robot name="triskel">
  <group name="arm">
    <joint name="arm_1" />
    <joint name="arm_2" />
    <joint name="arm_3" />
    <joint name="arm_4" />
    <joint name="arm_5" />
    <joint name="arm_6" />
    <joint name="arm_7" />
  </group>
  <group name="gripper">
    <joint name="gripper_1" />
  </group>

  <group_state name="home" group="arm">
    <joint name="arm_1" value="0" />
    <joint name="arm_2" value="0.75" />
    <joint name="arm_3" value="-0.5" />
    <joint name="arm_4" value="0" />
    <joint name="arm_5" value="0" />
    <joint name="arm_6" value="-1" />
    <joint name="arm_7" value="0" />
  </group_state>
  <group_state name="rest" group="arm">
    <joint name="arm_1" value="0" />
    <joint name="arm_2" value="1.6" />
    <joint name="arm_3" value="0.1" />
    <joint name="arm_4" value="-1.65" />
    <joint name="arm_5" value="0" />
    <joint name="arm_6" value="-0.21" />
    <joint name="arm_7" value="0" />
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper_1" value="0" />
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_1" value="-2.2" />
  </group_state>

  <end_effector
    name="gripper"
    parent_link="gripper_base_link"
    group="gripper"
    parent_group="arm"
  />

  <disable_collisions link1="wheel_2_link" link2="arm_base_link" reason="Adjacent" />
  <disable_collisions link1="wheel_3_link" link2="arm_base_link" reason="Adjacent" />
  <disable_collisions link1="arm_base_link" link2="arm_1_link" reason="Adjacent" />
  <disable_collisions link1="arm_1_link" link2="arm_2_link" reason="Adjacent" />
  <disable_collisions link1="arm_2_link" link2="arm_4_link" reason="Adjacent" />
  <disable_collisions link1="arm_4_link" link2="arm_6_link" reason="Adjacent" />
  <disable_collisions link1="arm_6_link" link2="finger_drive_link" reason="Adjacent" />
  <disable_collisions link1="arm_6_link" link2="gripper_base_link" reason="Adjacent" />
  <disable_collisions link1="finger_drive_link" link2="gripper_base_link" reason="Adjacent" />
</robot>
