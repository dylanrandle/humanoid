<?xml version="1.0"?>
<package format="3">
  <name>triskel_moveit_config</name>
  <version>0.2.0</version>
  <description>MoveIt 2 semantic, kinematic, planning, and controller configuration for Triskel.</description>

  <maintainer email="dylanrandle@users.noreply.github.com">Dylan Randle</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>triskel_description</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
