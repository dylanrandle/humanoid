#!/bin/bash

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

echo "Removing __pycache__ directories under ${PROJECT_ROOT}..."
find "${PROJECT_ROOT}" -type d -name __pycache__ -prune -exec rm -rf {} +

echo "Removing empty directories under ${PROJECT_ROOT}..."
find "${PROJECT_ROOT}" -type d -empty -not -path "*/.git/*" -delete

echo "Done."
