#!/usr/bin/env bash

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0")

Forward the robot dashboard to localhost.

Environment overrides:
  HUMANOID_ROBOT_HOST             SSH host (default: Host.ROBOT)
  HUMANOID_DASHBOARD_PORT         Remote dashboard port (default: Port.API)
  HUMANOID_LOCAL_DASHBOARD_PORT   Local dashboard port (default: remote port)
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi
if [[ $# -ne 0 ]]; then
    usage >&2
    exit 2
fi

NETWORK_DEFAULTS="$(uv run --project "$PROJECT_ROOT" python - <<'PY'
from humanoid.constants import Host, Port

print(Port.API, Host.ROBOT, Host.LOOPBACK)
PY
)"
read -r DEFAULT_PORT DEFAULT_ROBOT_HOST LOOPBACK_HOST <<< "$NETWORK_DEFAULTS"
REMOTE_HOST="${HUMANOID_ROBOT_HOST:-$DEFAULT_ROBOT_HOST}"
REMOTE_DASHBOARD_PORT="${HUMANOID_DASHBOARD_PORT:-$DEFAULT_PORT}"
LOCAL_DASHBOARD_PORT="${HUMANOID_LOCAL_DASHBOARD_PORT:-${REMOTE_DASHBOARD_PORT}}"

validate_port() {
    local label="$1"
    local port="$2"
    if [[ ! "${port}" =~ ^[0-9]+$ ]] || ((10#${port} < 1 || 10#${port} > 65535)); then
        echo "Invalid ${label} port: ${port}" >&2
        exit 2
    fi
}

validate_port "remote dashboard" "${REMOTE_DASHBOARD_PORT}"
validate_port "local dashboard" "${LOCAL_DASHBOARD_PORT}"

echo "Forwarding dashboard: http://${LOOPBACK_HOST}:${LOCAL_DASHBOARD_PORT}"
echo "Press Ctrl-C to close the tunnel."

ssh \
    -N \
    -T \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -L "${LOOPBACK_HOST}:${LOCAL_DASHBOARD_PORT}:${LOOPBACK_HOST}:${REMOTE_DASHBOARD_PORT}" \
    "${REMOTE_HOST}"
