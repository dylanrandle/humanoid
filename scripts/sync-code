#!/usr/bin/env bash

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE_HOST="${HUMANOID_ROBOT_HOST:-triskel}"
if [[ -n "${HUMANOID_ROBOT_DIR:-}" ]]; then
    REMOTE_DIR="${HUMANOID_ROBOT_DIR}"
else
    REMOTE_DIR='~/humanoid'
fi

usage() {
    cat <<EOF
Usage: $(basename "$0") [--dry-run]

Mirror the local Humanoid source tree to the robot with rsync.

Environment overrides:
  HUMANOID_ROBOT_HOST  SSH host (default: triskel)
  HUMANOID_ROBOT_DIR   Remote project directory (default: ~/humanoid)
EOF
}

RSYNC_OPTIONS=(
    --archive
    --compress
    --delete-delay
    --human-readable
    --itemize-changes
)

case "${1:-}" in
    "")
        ;;
    --dry-run)
        RSYNC_OPTIONS+=(--dry-run)
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
if [[ $# -gt 1 ]]; then
    usage >&2
    exit 2
fi

echo "Syncing ${PROJECT_ROOT}/ to ${REMOTE_HOST}:${REMOTE_DIR}/"
rsync "${RSYNC_OPTIONS[@]}" \
    --exclude='/.git/' \
    --exclude='/.venv/' \
    --exclude='/node_modules/' \
    --exclude='/logs/' \
    --exclude='/.vscode/' \
    --filter='-p .git/' \
    --filter='-p .venv/' \
    --filter='-p node_modules/' \
    --filter='-p logs/' \
    --filter='-p .vscode/' \
    --filter='-p __pycache__/' \
    --filter='-p .pytest_cache/' \
    --filter='-p .ruff_cache/' \
    --filter='-p .mypy_cache/' \
    --filter='-p .ty_cache/' \
    --filter='-p .coverage' \
    --filter='-p htmlcov/' \
    --filter='-p build/' \
    --filter='-p dist/' \
    --filter='-p wheels/' \
    --filter='-p *.egg-info/' \
    --filter='-p lcm-java/' \
    --filter='-p .DS_Store' \
    "${PROJECT_ROOT}/" \
    "${REMOTE_HOST}:${REMOTE_DIR%/}/"
