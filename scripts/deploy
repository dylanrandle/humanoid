#!/usr/bin/env bash

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE_HOST=""
INSTALL_DIR="${HUMANOID_ROBOT_DIR:-/opt/humanoid}"
BUILD_DIR="$(mktemp -d /tmp/humanoid-build.XXXXXX)"
REMOTE_STAGING_DIR=""

cleanup() {
    rm -rf -- "${BUILD_DIR:?}"
    if [[ -n "$REMOTE_STAGING_DIR" ]]; then
        ssh "$REMOTE_HOST" rm -rf -- "$REMOTE_STAGING_DIR" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

usage() {
    cat <<EOF
Usage: $(basename "$0") [--dry-run]

Build and install Humanoid with persistent local HTTPS on the robot.
Configures dashboard and Quest access at the robot hostname with a .local suffix.

Environment overrides:
  HUMANOID_ROBOT_HOST  SSH host (default: Host.ROBOT in project constants)
  HUMANOID_ROBOT_DIR   Remote install directory (default: /opt/humanoid)

The remote user needs passwordless sudo or an interactive terminal to create the
install directory and update the systemd service.
EOF
}

DRY_RUN=false
case "${1:-}" in
    "")
        ;;
    --dry-run)
        DRY_RUN=true
        ;;
    --help|-h)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
if [[ $# -gt 1 ]]; then
    usage >&2
    exit 2
fi
validate_install_dir() {
    local install_dir="$1"
    local component
    local -a components

    if [[ ! "$install_dir" =~ ^/[a-zA-Z0-9._/-]+$ ]]; then
        return 1
    fi
    if [[ "$install_dir" == "/" || "$install_dir" == *"//"* || "$install_dir" == */ ]]; then
        return 1
    fi

    IFS="/" read -r -a components <<< "${install_dir#/}"
    for component in "${components[@]}"; do
        if [[ -z "$component" || "$component" == "." || "$component" == ".." ]]; then
            return 1
        fi
    done
}

if ! validate_install_dir "$INSTALL_DIR"; then
    echo "HUMANOID_ROBOT_DIR must be a normalized absolute path without empty, '.' or '..' components." >&2
    exit 2
fi

cd "$PROJECT_ROOT"

MODEL_ENGINES=(
    models/cdm/d405.plan
    models/cdm/d435.plan
    models/nanosam/encoder.plan
    models/nanosam/decoder.plan
)
for engine in "${MODEL_ENGINES[@]}"; do
    if [[ ! -f "$engine" || ! -s "$engine" || ! -r "$engine" ]] ||
        head -c 42 "$engine" | LC_ALL=C grep -aq '^version https://git-lfs'; then
        echo "Missing or unmaterialized TensorRT engine: $engine. Run git lfs pull --include='models/**/*.plan'." >&2
        exit 1
    fi
done

echo "Building Humanoid wheel and locked runtime requirements"
REMOTE_HOST="${HUMANOID_ROBOT_HOST:-$(uv run python -c 'from humanoid.constants import Host; print(Host.ROBOT)')}"
uv build --wheel --out-dir "$BUILD_DIR"
uv export \
    --frozen \
    --no-dev \
    --no-emit-project \
    --no-header \
    --no-annotate \
    --output-file "$BUILD_DIR/requirements.txt" \
    >/dev/null

shopt -s nullglob
WHEELS=("$BUILD_DIR"/humanoid-*.whl)
shopt -u nullglob
if [[ ${#WHEELS[@]} -ne 1 || ! -f "${WHEELS[0]}" ]]; then
    echo "Expected one Humanoid wheel, found ${#WHEELS[@]}." >&2
    exit 1
fi
WHEEL_NAME="$(basename "${WHEELS[0]}")"
BUNDLE_PATH="$BUILD_DIR/humanoid-deploy.tar.gz"
install -m 0644 "$PROJECT_ROOT/deploy/humanoid.service" \
    "$BUILD_DIR/humanoid.service.template"
install -m 0644 "$PROJECT_ROOT/.python-version" "$BUILD_DIR/.python-version"
install -m 0644 "$PROJECT_ROOT/deploy/90-humanoid-lcm.conf" "$BUILD_DIR/90-humanoid-lcm.conf"
# Render the gateway from the same defaults shipped in the backend wheel.
# Local development environment overrides must not change deployed listener ports.
uv run python - "$PROJECT_ROOT/deploy/Caddyfile" "$BUILD_DIR/Caddyfile" <<'CADDY_CONFIG'
import sys
from pathlib import Path

from humanoid.constants import Host, Port

template = Path(sys.argv[1]).read_text()
for prefix, values in (("HOST", Host), ("PORT", Port)):
    for value in values:
        template = template.replace(f"@{prefix}_{value.name}@", str(value))
Path(sys.argv[2]).write_text(template)
CADDY_CONFIG
install -m 0644 "$PROJECT_ROOT/deploy/humanoid-gateway.service" \
    "$BUILD_DIR/humanoid-gateway.service.template"
# Avoid macOS extended attributes in bundles extracted by GNU tar on Ubuntu.
COPYFILE_DISABLE=1 tar --no-xattrs -C "$BUILD_DIR" -czf "$BUNDLE_PATH" \
    "$WHEEL_NAME" requirements.txt humanoid.service.template .python-version 90-humanoid-lcm.conf \
    Caddyfile humanoid-gateway.service.template

if [[ "$DRY_RUN" == true ]]; then
    echo "Would upload the deployment bundle to $REMOTE_HOST"
    echo "Would install Humanoid into $INSTALL_DIR"
    for engine in "${MODEL_ENGINES[@]}"; do
        echo "Would sync $engine to $REMOTE_HOST:$INSTALL_DIR/$engine"
    done
    echo "Would configure persistent 8 MiB LCM receive buffers"
    echo "Would install EGL/Mesa libraries for headless simulation cameras"
    echo "Would install Caddy if missing and configure local HTTPS and mDNS"
    echo "Would enable and restart humanoid.service and humanoid-gateway.service"
    exit 0
fi

REMOTE_INSTALL_DIR="$(ssh "$REMOTE_HOST" realpath -m -- "$INSTALL_DIR")"
if [[ "$REMOTE_INSTALL_DIR" != "$INSTALL_DIR" ]]; then
    echo "Robot resolved $INSTALL_DIR to $REMOTE_INSTALL_DIR; refusing to deploy through aliases or symlinks." >&2
    exit 1
fi

echo "Creating temporary upload directory on $REMOTE_HOST"
REMOTE_STAGING_DIR="$(ssh "$REMOTE_HOST" mktemp -d /tmp/humanoid-deploy.XXXXXX)"
if [[ "$REMOTE_STAGING_DIR" != /tmp/humanoid-deploy.* ]]; then
    echo "Robot returned an unexpected temporary directory: $REMOTE_STAGING_DIR" >&2
    REMOTE_STAGING_DIR=""
    exit 1
fi
REMOTE_BUNDLE="$REMOTE_STAGING_DIR/$(basename "$BUNDLE_PATH")"

echo "Uploading deployment bundle to $REMOTE_HOST"
scp "$BUNDLE_PATH" "$REMOTE_HOST:$REMOTE_BUNDLE"

if ssh "$REMOTE_HOST" test -e "$INSTALL_DIR"; then
    if ! ssh "$REMOTE_HOST" test -d "$INSTALL_DIR"; then
        echo "$INSTALL_DIR exists on $REMOTE_HOST but is not a directory." >&2
        exit 1
    fi
    if ! ssh "$REMOTE_HOST" test -w "$INSTALL_DIR"; then
        echo "$INSTALL_DIR exists on $REMOTE_HOST but is not writable by the deployment user." >&2
        exit 1
    fi
else
    echo "Preparing $INSTALL_DIR on $REMOTE_HOST"
    ssh -t "$REMOTE_HOST" \
        "sudo install -d -m 0755 -o \$(id -u) -g \$(id -g) '$INSTALL_DIR'"
fi

echo "Syncing TensorRT engines to $REMOTE_HOST:$INSTALL_DIR/models"
# Preserve runtime paths and skip engines whose contents are already installed.
rsync -rtR --checksum --delay-updates -- "${MODEL_ENGINES[@]}" "$REMOTE_HOST:$INSTALL_DIR/"

echo "Installing Humanoid into $REMOTE_HOST:$INSTALL_DIR"
ssh "$REMOTE_HOST" bash -s -- "$INSTALL_DIR" "$REMOTE_BUNDLE" "$WHEEL_NAME" <<'REMOTE_SCRIPT'
set -euo pipefail

INSTALL_DIR="$1"
BUNDLE_PATH="$2"
WHEEL_NAME="$3"
STAGING_DIR="$(dirname "$BUNDLE_PATH")"
SERVICE_USER="$(id -un)"
PUBLIC_HOST="$(hostname -s).local"
CADDY="$INSTALL_DIR/bin/caddy"
GATEWAY_DIR="$INSTALL_DIR/gateway"

if [[ ! "$SERVICE_USER" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "Cannot create a systemd unit for unexpected user name: $SERVICE_USER" >&2
    exit 1
fi

if [[ ! "$PUBLIC_HOST" =~ ^[a-zA-Z0-9-]+\.local$ ]]; then
    echo "Unsupported hostname for HTTPS service templates." >&2
    exit 1
fi

if command -v uv >/dev/null; then
    UV_BIN="$(command -v uv)"
elif [[ -x "$HOME/.local/bin/uv" ]]; then
    UV_BIN="$HOME/.local/bin/uv"
else
    echo "uv is not available on the robot. Install uv and deploy again." >&2
    exit 1
fi

tar -xzf "$BUNDLE_PATH" -C "$STAGING_DIR"
install -d -m 0755 "$INSTALL_DIR/logs"

install_caddy() (
    # Preserve an existing gateway binary and its separate certificate storage.
    if [[ -x "$CADDY" ]]; then return; fi
    case "$(uname -m)" in
        aarch64) arch=arm64 ;;
        x86_64) arch=amd64 ;;
        *) echo 'Unsupported Linux architecture for Caddy' >&2; exit 1 ;;
    esac
    version=2.11.9
    staging="$(mktemp -d)"
    trap 'rm -rf -- "$staging"' EXIT
    archive="caddy_${version}_linux_${arch}.tar.gz"
    release="https://github.com/caddyserver/caddy/releases/download/v${version}"
    curl -fL --retry 2 "$release/$archive" -o "$staging/$archive"
    curl -fL --retry 2 "$release/caddy_${version}_checksums.txt" -o "$staging/checksums.txt"
    (
        cd "$staging"
        awk -v archive="$archive" '$2 == archive {print}' checksums.txt | sha512sum --check --strict -
    )
    tar -xzf "$staging/$archive" -C "$staging" caddy
    install -d -m 0755 "$(dirname "$CADDY")"
    install -m 0755 "$staging/caddy" "$CADDY"
)
install_caddy
install -d -m 0755 "$GATEWAY_DIR"
# This is persistent certificate/key storage, not deployment scratch space.
install -d -m 0700 "$GATEWAY_DIR/data" "$GATEWAY_DIR/config"
HUMANOID_PUBLIC_HOST="$PUBLIC_HOST" \
    XDG_DATA_HOME="$GATEWAY_DIR/data" XDG_CONFIG_HOME="$GATEWAY_DIR/config" \
    "$CADDY" validate --config "$STAGING_DIR/Caddyfile" --adapter caddyfile
install -m 0644 "$STAGING_DIR/Caddyfile" "$GATEWAY_DIR/Caddyfile"

PYTHON_VERSION="$(cat "$STAGING_DIR/.python-version")"
if [[ ! "$PYTHON_VERSION" =~ ^[0-9]+\.[0-9]+$ ]]; then
    echo "Invalid Python version in deployment bundle: $PYTHON_VERSION" >&2
    exit 1
fi
"$UV_BIN" venv --python "$PYTHON_VERSION" --allow-existing "$INSTALL_DIR/.venv"
"$UV_BIN" pip install \
    --python "$INSTALL_DIR/.venv/bin/python" \
    --exact \
    --compile-bytecode \
    --reinstall-package humanoid \
    --requirements "$STAGING_DIR/requirements.txt" \
    "$STAGING_DIR/$WHEEL_NAME"
# Use the TensorRT bindings supplied with the Jetson's native runtime.
JETPACK_PACKAGES="/usr/lib/python$PYTHON_VERSION/dist-packages"
if [[ -d "$JETPACK_PACKAGES/tensorrt" ]]; then
    printf '%s\n' "$JETPACK_PACKAGES" > "$INSTALL_DIR/.venv/lib/python$PYTHON_VERSION/site-packages/jetpack.pth"
fi
ln -sfn .venv/bin/start "$INSTALL_DIR/start"

for unit in humanoid humanoid-gateway; do
    sed \
        -e "s|@HUMANOID_USER@|$SERVICE_USER|g" \
        -e "s|@HUMANOID_INSTALL_DIR@|$INSTALL_DIR|g" \
        -e "s|@HUMANOID_PUBLIC_HOST@|$PUBLIC_HOST|g" \
        "$STAGING_DIR/$unit.service.template" > "$STAGING_DIR/$unit.service"
done

"$UV_BIN" run --no-project --python "$INSTALL_DIR/.venv/bin/python" \
    python -c "import humanoid; import pyrealsense2"
echo "Installed Humanoid package"
REMOTE_SCRIPT

# Keep the privileged activation step reproducible if sudo needs a local terminal.
ssh "$REMOTE_HOST" "cat > '$REMOTE_STAGING_DIR/activate.sh'" <<'ACTIVATE_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail
STAGING_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
apt-get update
apt-get install -y --no-install-recommends libegl1 libegl-mesa0 libopengl0 libgl1-mesa-dri avahi-daemon
install -m 0644 "$STAGING_DIR/90-humanoid-lcm.conf" /etc/sysctl.d/90-humanoid-lcm.conf
sysctl -p /etc/sysctl.d/90-humanoid-lcm.conf
install -m 0644 "$STAGING_DIR/humanoid.service" /etc/systemd/system/humanoid.service
install -m 0644 "$STAGING_DIR/humanoid-gateway.service" /etc/systemd/system/humanoid-gateway.service
systemctl daemon-reload
systemctl enable humanoid.service humanoid-gateway.service avahi-daemon
systemctl start avahi-daemon
systemctl restart humanoid.service humanoid-gateway.service
sleep 1
systemctl --no-pager --full status humanoid.service humanoid-gateway.service
ACTIVATE_SCRIPT

echo "Installing system dependencies and restarting backend and HTTPS services on $REMOTE_HOST"
if ! ssh -t "$REMOTE_HOST" "sudo bash '$REMOTE_STAGING_DIR/activate.sh'"; then
    echo "Activation did not finish; the installed package and staged service files are retained." >&2
    echo "Finish from an interactive terminal:" >&2
    echo "ssh -t $REMOTE_HOST 'sudo bash $REMOTE_STAGING_DIR/activate.sh'" >&2
    echo "After successful activation, remove $REMOTE_STAGING_DIR on the robot." >&2
    REMOTE_STAGING_DIR=""
    exit 1
fi

echo "Deployment complete; backend and HTTPS gateway are enabled and running"
