package humanoid.types.lcm;

struct robot_tool_command_t {
    int64_t timestamp;
    double position[3];
    double quaternion[4];  // wxyz format (w, x, y, z)
    int8_t has_velocity;
    double linear_velocity[3];
    double angular_velocity[3];
    int32_t num_gripper_joints;
    double gripper_positions[num_gripper_joints];
}
