package humanoid.types.lcm;

struct collection_run_status_t {
    int64_t timestamp;
    string run_id;
    string state;
    string task;
    int64_t episodes;
    int64_t max_attempts;
    int64_t attempts;
    int64_t successes;
    int64_t seed;
    string phase;
    string target;
    double sim_seconds;
    int64_t actions;
    int64_t samples;
    string recording;
    string message;
}
