<?xml version="1.0"?>
<robot name="triskel">
    <!-- All eleven drives use the Feetech STS3215-C001 on a 7.4 V supply.
         Motor mass, stall torque and no-load speed are from sections 5 and 6.
         https://files.seeedstudio.com/products/Feetech/108090023_STS3215-C001_Datasheet.pdf
         Output-shaft Coulomb and viscous friction are estimates from the BAM M1 bench fit.
    https://github.com/Rhoban/bam/blob/279c4828c466e7e19b631c45203b0e3582be9869/bam/params/feetech_sts3215_7_4V/m1.json
         Nexus RB-Nex-08 (manufacturer 14049) wheels: 100 mm diameter, 290 g each.
         https://www.nexusrobot.com/product/4-inch-100mm-double-plastic-omni-wheel-basic-14049.html
         User-measured base plates: 303 g each; wheel mounts: 20 g each (2026-11-02).
         Other printed part masses remain unverified estimates.
         Motor COM locations are existing geometry estimates, not manufacturer data.
    -->
    <mujoco>
        <compiler boundmass="0" boundinertia="0" />
        <option cone="elliptic">
            <flag diagexact="enable" />
        </option>
    </mujoco>
    <material name="silver">
        <color rgba="0.700 0.700 0.700 1.000" />
    </material>
    <material name="black">
        <color rgba="0.04 0.04 0.04 1" />
    </material>
    <material name="finray_blue">
        <color rgba="0.03 0.25 0.85 1" />
    </material>
    <link name="lower_plate_link">
        <!-- Measured mass; inertia scaled proportionally, retaining estimated COM and shape. -->
        <inertial>
            <mass value="0.303" />
            <origin xyz="-1.67956e-15 -2.71555e-05 0.0035" rpy="0 -0 0" />
            <inertia ixx="0.0008773314127" ixy="0" ixz="0" iyy="0.0008759826175" iyz="0"
                izz="0.001750843682" />
        </inertial>
        <visual>
            <origin xyz="0 0 0.007" rpy="0 -0 0" />
            <geometry>
                <mesh filename="package://triskel/meshes/lower_plate.obj" scale="1 1 1" />
            </geometry>
            <material name="silver" />
        </visual>
    </link>
    <!-- Mount moved one 20 mm hole row toward the plate center.
         Mount rests on the lower plate's top surface (z = 7 mm).
         The 40 mm hole pair aligns with base-frame (x, y) = (+/-20, 80) mm.
         Camera rear mounting face is at y = 68 mm, facing forward (+Y).
         Camera screw centers are at (x, y, z) = (+/-22.5, 68, 32) mm.
         Mount inertia is estimated from its solid STL at 1200 kg/m^3. -->
    <link name="ego_camera_mount_link">
        <inertial>
            <origin xyz="0 -0.01444524 -0.00193615" />
            <mass value="0.00671547" />
            <inertia ixx="8.8490e-7" ixy="0" ixz="0" iyy="1.29128e-6" iyz="-2.07122e-7"
                izz="1.83317e-6" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://triskel/meshes/ego_camera_mount.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
            <material name="silver" />
        </visual>
    </link>
    <joint name="ego_camera_mount_joint" type="fixed">
        <origin xyz="0 0.068 0.032" rpy="1.5707963267948966 0 0" />
        <parent link="lower_plate_link" />
        <child link="ego_camera_mount_link" />
    </joint>
    <!-- Upright RealSense D435, rear face flush at base y = 68 mm.
         camera_link uses forward/left/up axes at the nominal depth origin.
         Optical frames use right/down/forward; derive base transforms from this tree.
         Official mesh converted to OBJ; provenance/license: meshes/d435_notice.txt.
         Inertia approximates the 75 g housing as a uniform 25 x 90 x 25 mm box.
         Color baseline is nominal. -->
    <!-- D435 housing dimensions and mass, RealSense D400 family datasheet, table 3-52.
    https://www.realsenseai.com/wp-content/uploads/2025/09/Intel-RealSense-D400-Series-Datasheet-October-2025.pdf -->
    <link name="ego_camera_link">
        <inertial>
            <origin xyz="-0.0082 -0.0175 0" />
            <mass value="0.075" />
            <inertia ixx="5.453125e-5" ixy="0" ixz="0" iyy="7.8125e-6" iyz="0" izz="5.453125e-5" />
        </inertial>
        <visual>
            <origin xyz="0.0043 -0.0175 0" rpy="1.5707963267948966 0 1.5707963267948966" />
            <geometry>
                <mesh filename="package://triskel/meshes/d435.obj" scale="1 1 1" />
            </geometry>
            <material name="silver" />
        </visual>
    </link>
    <joint name="ego_camera_joint" type="fixed">
        <origin xyz="-0.0175 0 -0.02075" rpy="0 1.5707963267948966 1.5707963267948966" />
        <parent link="ego_camera_mount_link" />
        <child link="ego_camera_link" />
    </joint>
    <link name="ego_camera_depth_optical_frame" />
    <joint name="ego_camera_depth_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
        <parent link="ego_camera_link" />
        <child link="ego_camera_depth_optical_frame" />
    </joint>
    <link name="ego_camera_color_optical_frame" />
    <joint name="ego_camera_color_optical_joint" type="fixed">
        <origin xyz="-0.015 0 0" rpy="0 0 0" />
        <parent link="ego_camera_depth_optical_frame" />
        <child link="ego_camera_color_optical_frame" />
    </joint>
